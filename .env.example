# Copy to .env and fill in values. Never commit .env.

# --- web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# --- api ---
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
API_ENV=development
API_LOG_LEVEL=INFO

# API connection: non-superuser role subject to row-level security (docker compose creates eca_app).
API_DATABASE_URL=postgresql://eca_app:eca_app_dev@localhost:5432/eca
# Worker connection (python -m eca.worker, eca ops): the separate worker role (compose creates eca_worker).
API_WORKER_DATABASE_URL=postgresql://eca_worker:eca_worker_dev@localhost:5432/eca
# Migration connection: schema owner, used only by `alembic upgrade` (release step).
API_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eca
# Runtime roles that migrations grant to (they never create roles).
API_DB_RUNTIME_ROLE=eca_app
API_DB_WORKER_ROLE=eca_worker

# Optional error reporting (disabled when empty).
SENTRY_DSN=

# --- Gemini (paid tier only for user data). Key from https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Legacy smoke-test variable used by test_gemini_key.py. Model IDs for the application
# come from config/models.yaml (AI_PIPELINE.md §2), not from this variable.
API_GEMINI_MODEL=
# AI provider layer (BACKEND_DESIGN.md §5.5): live | replay | record (record is refused in production).
API_AI_MODE=live
# Defaults to <repo>/config (models.yaml, pricing.yaml).
API_AI_CONFIG_DIR=
# Required in replay and record mode, e.g. evals/ai/cassettes/live (git-ignored).
API_AI_CASSETTE_DIR=
API_AI_TIMEOUT_S=60

# --- Google OAuth (slices 1.1 sign-in, 1.2 connect). Client secret only via environment/secret manager ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SIGNIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback
WEB_BASE_URL=http://localhost:3000
# Local HTTP development only; must stay true anywhere else.
SESSION_COOKIE_SECURE=true
# Refresh-token key-encryption key: base64 of 32 random bytes (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
TOKEN_KEK=
TOKEN_KEK_VERSION=1

# --- Web Push (slice 3.1). Never commit real keys; create a pair with `eca ops vapid-keys`.
# Public key: base64url uncompressed P-256 point. Private key: base64url 32-byte scalar (a secret).
# Subject: mailto: or https: contact for the push services. Empty = Web Push disabled (in-app only).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# --- Object storage and media (Phase 4). The local adapter is for development only.
# Default directory: <repo>/.local/objects (git-ignored). The signing key makes upload URLs
# (a secret; unset = random per process, so pending upload URLs stop working on restart).
API_STORAGE_BACKEND=local
API_STORAGE_LOCAL_DIR=
STORAGE_SIGNING_KEY=
# Worker only: ffmpeg/ffprobe binaries (default: on PATH) and the temporary directory for media jobs.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
API_MEDIA_TMP_DIR=
